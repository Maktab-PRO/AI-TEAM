APP_ENV=development
AI_TEAM_REGISTRY_PATH=./config/projects.json
# Leave DATABASE_URL blank for local SQLite. In deployments, set a dedicated AI TEAM PostgreSQL URL.
# Never point this to Axsikent or Technikum databases.
DATABASE_URL=
AI_TEAM_DB_PATH=./data/ai-team.sqlite3
# Generate private, high-entropy bearer token(s) (at least 32 characters); never commit real tokens.
AI_TEAM_API_TOKEN=
# Single-token identity and least-privilege scope (used with AI_TEAM_API_TOKEN in production).
# Roles: platform_admin, project_admin, worker, reviewer, read_only.
# platform_admin requires AI_TEAM_API_PROJECTS=*; all other roles must list exact project IDs.
AI_TEAM_API_ACTOR=api-token
AI_TEAM_API_ROLE=read_only
AI_TEAM_API_PROJECTS=ai-team-control-plane
# Optional JSON map: {"<32+ character token>":{"actor":"worker-a","role":"worker","projects":["ai-team-control-plane"]}}.
# Each token needs an explicit role and project scope; never commit actual tokens.
AI_TEAM_API_TOKENS=
# Shared database-backed fixed-window request limit, applied per client peer and bearer-token fingerprint.
# Production must set a limit from 1 to 10000 and a unique 32+ character random HMAC key in the secret manager.
AI_TEAM_RATE_LIMIT_PER_MINUTE=120
AI_TEAM_RATE_LIMIT_HASH_KEY=
# Optional; only used after the Redis publisher is configured explicitly.
REDIS_URL=
# Fine-grained token needs Contents: read, Metadata: read, Actions: read, and Pull requests: read.
# No write permissions are needed. Store only in the host secret manager.
AI_TEAM_GITHUB_TOKEN=
# Exact allowed workflow paths per repository. Do not add a path unless its checks are reviewed.
# Example: {"Maktab-PRO/AI-TEAM":[".github/workflows/ci.yml"]}
AI_TEAM_GITHUB_WORKFLOW_ALLOWLIST=
# Per-project health target map; verifier only performs GET on configured HTTPS /health URLs.
# Returned JSON must match expected_service and expected_status; redirects and IP/local hosts are rejected.
# Example: {"axsikent-it":{"url":"https://your-service.onrender.com/health","expected_service":"your-service","expected_status":"ok"}}
AI_TEAM_RENDER_HEALTH_ALLOWLIST=
