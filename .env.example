APP_ENV=development
AI_TEAM_REGISTRY_PATH=./config/projects.json
# Leave DATABASE_URL blank for local SQLite. In deployments, set a dedicated AI TEAM PostgreSQL URL.
# Never point this to Axsikent or Technikum databases.
DATABASE_URL=
AI_TEAM_DB_PATH=./data/ai-team.sqlite3
# Generate private, high-entropy bearer token(s) (at least 32 characters); never commit real tokens.
AI_TEAM_API_TOKEN=
# Single-token identity and least-privilege scope (used with AI_TEAM_API_TOKEN in production).
# Roles: platform_admin, project_admin, worker, reviewer, read_only.
# platform_admin requires AI_TEAM_API_PROJECTS=*; all other roles must list exact project IDs.
AI_TEAM_API_ACTOR=api-token
AI_TEAM_API_ROLE=read_only
AI_TEAM_API_PROJECTS=axsikent-it
# Optional JSON map: {"<32+ character token>":{"actor":"worker-a","role":"worker","projects":["axsikent-it"]}}.
# Each token needs an explicit role and project scope; never commit actual tokens.
AI_TEAM_API_TOKENS=
# Optional; only used after the Redis publisher is configured explicitly.
REDIS_URL=
